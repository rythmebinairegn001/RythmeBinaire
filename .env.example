# Copie ce fichier en .env.local pour le dev local, et remplis les valeurs.
# Sur Vercel : Settings > Environment Variables (mêmes noms).
VITE_SUPABASE_URL=https://TON-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=ta_cle_anon_publique

# Tuteur IA (facultatif) : adresse de la fonction Supabase "tutor-hint".
# Exemple : https://TON-PROJET.supabase.co/functions/v1/tutor-hint
# Laisse vide tant que la fonction n'est pas déployée (le site utilise alors de faux indices [MOCK]).
VITE_TUTOR_API_URL=

# Comptes enfants (facultatif) : domaine de l'e-mail interne fabriqué pour chaque enfant.
# Doit être IDENTIQUE au secret CHILD_EMAIL_DOMAIN de la fonction "manage-child". Laisse vide par défaut.
VITE_CHILD_EMAIL_DOMAIN=
